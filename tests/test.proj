<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Test">
  <PropertyGroup>
    <TestProgram>$(MSBuildThisFileDirectory)Sigourney.Tests/Sigourney.Tests.csproj</TestProgram>
  </PropertyGroup>
  <ItemGroup>
    <!-- We only want to build these projects. -->
    <BuildTest Include="./buildtest-*/*.csproj" />
    <LocalPackage Include="./Sigourney.TestWeaver*/*.csproj" />
  </ItemGroup>

  <Target Name="Restore">
    <MSBuild Projects="@(BuildTest);$(TestProgram)" Targets="Restore" BuildInParallel="$(BuildInParallel)" />
  </Target>

  <Target Name="RunBuildTests">
    <MSBuild Projects="@(BuildTest)" Targets="Build" BuildInParallel="$(BuildInParallel)" />
  </Target>

  <Target Name="BuildTestProgram">
    <MSBuild Projects="$(TestProgram)" Targets="Build" BuildInParallel="$(BuildInParallel)" />
  </Target>
  <Target Name="RunTestProgram" DependsOnTargets="BuildTestProgram">
    <Exec Command="dotnet run --project $(TestProgram) --no-build" />
  </Target>

  <Target Name="Clean">
    <MSBuild Projects="@(BuildTest);$(TestProgram)" Targets="Clean" BuildInParallel="$(BuildInParallel)" />
  </Target>

  <Target Name="Test" DependsOnTargets="RunBuildTests;RunTestProgram" />
</Project>
